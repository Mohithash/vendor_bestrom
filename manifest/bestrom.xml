<?xml version="1.0" encoding="UTF-8"?>
<!-- BestROM projects on top of VoltageOS 17. Generated from
     vendor/bestrom/manifest/bestrom.xml by gen-manifest.py; every project on the
     "bestrom" remote inherits revision="17" from default.xml. -->
<manifest>
  <remote name="bestrom" fetch="https://github.com/Mohithash/" revision="17" />
  <remote name="gh" fetch="https://github.com/" />
  <remote name="gl" fetch="https://gitlab.com/" />
  <project name="device_xiaomi_peridot" path="device/xiaomi/peridot" remote="bestrom" />
  <project name="vendor_bestrom" path="vendor/bestrom" remote="bestrom" >
    <copyfile src="tools/AGENTS.md" dest="AGENTS.md" />
    <copyfile src="tools/CLAUDE.md" dest="CLAUDE.md" />
    <copyfile src="tools/mcp.json" dest=".mcp.json" />
  </project>
  <remove-project name="frameworks_base_new" />
  <project name="frameworks_base" path="frameworks/base" remote="bestrom" />
  <remove-project name="packages_apps_Settings" />
  <project name="packages_apps_Settings" path="packages/apps/Settings" remote="bestrom" />
  <remove-project name="frameworks_opt_telephony" />
  <project name="frameworks_opt_telephony" path="frameworks/opt/telephony" remote="bestrom" />
  <remove-project name="packages_apps_SetupWizard" />
  <project name="packages_apps_SetupWizard" path="packages/apps/SetupWizard" remote="bestrom" />
  <remove-project name="packages_apps_Updater" />
  <project name="packages_apps_Updater" path="packages/apps/Updater" remote="bestrom" />
  <remove-project name="packages_apps_Launcher3" />
  <project name="packages_apps_Launcher3" path="packages/apps/Launcher3" remote="bestrom" />
  <remove-project name="device_voltage_sepolicy" />
  <project name="device_voltage_sepolicy" path="device/voltage/sepolicy" remote="bestrom" />
  <project name="vendor_xiaomi_peridot" path="vendor/xiaomi/peridot" remote="bestrom" />
  <project name="kernel_xiaomi_sm8635" path="kernel/xiaomi/sm8635" remote="bestrom" />
  <project name="GuidixX/kernel_xiaomi_sm8635-modules" path="kernel/xiaomi/sm8635-modules" remote="gh" revision="16.2" />
  <project name="GuidixX/kernel_xiaomi_sm8635-devicetrees" path="kernel/xiaomi/sm8635-devicetrees" remote="gh" revision="16.2" />
  <project name="packages_apps_Freezer" path="packages/apps/Freezer" remote="bestrom" />
  <project name="packages_apps_Edge" path="packages/apps/Edge" remote="bestrom" />
  <project name="peridot-dev/android_device_xiaomi_peridot-miuicamera" path="device/xiaomi/peridot-miuicamera" remote="gh" revision="lineage-23.2" />
  <project name="NoPrincessHere/proprietary_vendor_xiaomi_peridot-miuicamera" path="vendor/xiaomi/peridot-miuicamera" remote="gl" revision="sixteen-qpr2" />
  <remove-project name="bootable_recovery" />
  <project name="bootable_recovery" path="bootable/recovery" remote="bestrom" />
  <remove-project name="build_soong" />
  <project name="build_soong" path="build/soong" remote="bestrom" />
  <remove-project name="build" />
  <project name="build" path="build/make" remote="bestrom" >
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <remove-project name="frameworks_native" />
  <remove-project name="frameworks_av" />
  <project name="frameworks_native" path="frameworks/native" remote="bestrom" />
  <project name="frameworks_av" path="frameworks/av" remote="bestrom" />
  <remove-project name="vendor_voltage" />
  <project name="vendor_voltage" path="vendor/voltage" remote="bestrom" />
  <remove-project name="hardware_voltage_interfaces" />
  <project name="hardware_voltage_interfaces" path="hardware/voltage/interfaces" remote="bestrom" />
  <remove-project name="hardware_xiaomi" />
  <project name="hardware_xiaomi" path="hardware/xiaomi" remote="bestrom" />
  <remove-project name="hardware_google_pixel" />
  <project name="hardware_google_pixel" path="hardware/google/pixel" remote="bestrom" />
  <remove-project name="packages_apps_ParanoidSense" />
  <project name="packages_apps_ParanoidSense" path="packages/apps/ParanoidSense" remote="bestrom" />
  <project name="packages_apps_BestromPreinstaller" path="packages/apps/BestromPreinstaller" remote="bestrom" />
  <remove-project name="packages_apps_Powerhub" />
  <project name="packages_apps_Powerhub" path="packages/apps/Powerhub" remote="bestrom" />
  <remove-project name="system_sepolicy" />
  <project name="system_sepolicy" path="system/sepolicy" remote="bestrom" />
  <!-- GameSpace is debloated on peridot, so its sources are not needed. -->
  <remove-project name="packages_apps_GameSpace" />
</manifest>
