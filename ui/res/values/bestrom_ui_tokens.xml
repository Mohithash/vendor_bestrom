<!--
  Shared Nothing-adjacent tokens for BestROM apps that do not link SettingsLib.
  Numbers match packages/apps/Settings/res/values/bestrom_settings.xml.
-->
<resources>

    <!-- Surfaces (light). Apps may override night in their own values-night. -->
    <color name="bestrom_ui_page_bg">#FFF7F7F7</color>
    <color name="bestrom_ui_surface">#FFFFFFFF</color>
    <color name="bestrom_ui_surface_high">#FFECECEC</color>
    <color name="bestrom_ui_surface_highest">#FFE0E0E0</color>
    <color name="bestrom_ui_on_surface">#FF121212</color>
    <color name="bestrom_ui_on_surface_variant">#FF5A5A5A</color>
    <color name="bestrom_ui_outline">#FFB0B0B0</color>
    <color name="bestrom_ui_muted">#FF6A6A6A</color>
    <color name="bestrom_ui_primary">#FF1A1A1A</color>
    <color name="bestrom_ui_on_primary">#FFFFFFFF</color>

    <dimen name="bestrom_ui_row_corner_radius">22dp</dimen>
    <dimen name="bestrom_ui_card_corner_radius">22dp</dimen>
    <dimen name="bestrom_ui_card_padding">16dp</dimen>
    <dimen name="bestrom_ui_title_text_size">15sp</dimen>
    <dimen name="bestrom_ui_body_text_size">14sp</dimen>
    <dimen name="bestrom_ui_status_text_size">28sp</dimen>

    <style name="TextAppearance.BestromUi.Title">
        <item name="android:fontFamily">space-grotesk-semi-bold</item>
        <item name="android:textSize">@dimen/bestrom_ui_title_text_size</item>
        <item name="android:textColor">@color/bestrom_ui_on_surface</item>
    </style>

    <style name="TextAppearance.BestromUi.Body">
        <item name="android:fontFamily">space-grotesk</item>
        <item name="android:textSize">@dimen/bestrom_ui_body_text_size</item>
        <item name="android:textColor">@color/bestrom_ui_on_surface_variant</item>
    </style>

    <style name="TextAppearance.BestromUi.Status">
        <item name="android:fontFamily">doto</item>
        <item name="android:textSize">@dimen/bestrom_ui_status_text_size</item>
        <item name="android:textColor">@color/bestrom_ui_on_surface</item>
    </style>

</resources>
