//
// SPDX-FileCopyrightText: BestROM
// SPDX-License-Identifier: Apache-2.0
//
// LeanType, a HeliBoard fork, shipped in place of AOSP LatinIME.
//
// overrides: ["LatinIME"] drops the AOSP module, which is added twice - by
// build/make/target/product/handheld_product.mk and by
// vendor/voltage/config/common_mobile.mk. Doing it here rather than editing
// either file keeps BestROM out of vendor/voltage.
//
// This is a BestROM build of github.com/Mohithash/LeanType branch bestrom-17 -
// upstream v4.2.0 plus one commit defaulting the keyboard to 100% height and no
// side padding, which are compiled-in Kotlin constants no RRO can reach. The
// same commit is kept in patches/ so the binary can be reproduced from the
// upstream tag alone. See README.md.
//
// LeanType.apk is the unsigned Gradle release output, so this is an ordinary
// signed module: default_dev_cert: true makes Soong sign and zipalign it with
// PRODUCT_DEFAULT_DEV_CERTIFICATE, the identity every BestROM app module
// carries. Do not go back to presigned/preprocessed for a fork build -
// sign_target_files_apks skips presigned modules, so the keyboard would stay
// on the old key while the rest of the image rotated to release keys.
//
// The cost of the fork is the signature: the upstream artifact carried LeanBit
// Lab's key, the same one F-Droid publishes for com.leanbitlab.leantype, which
// let an F-Droid or GitHub build install as an update over the system copy.
// This one cannot, so the OTA is the keyboard's only update channel.
//
// The app is not privileged and requests no signature-level permissions, so it
// needs no privapp-permissions file and no seapp_contexts entry; it runs in
// untrusted_app like any other third-party IME. It publishes its own
// AndroidSpellCheckerService, which replaces the one LatinIME provided.
//

package {
    default_applicable_licenses: ["vendor_bestrom_prebuilt_LeanType_license"],
}

// LeanType is GPL-3.0, inherited from HeliBoard and OpenBoard. LICENSE is the
// upstream text at the shipped tag. Without this the module carries no
// license_kinds at all, and the generated NOTICE - which lists AOSP LatinIME
// today - would say nothing about the keyboard that replaces it.
license {
    name: "vendor_bestrom_prebuilt_LeanType_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-GPL-3.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

android_app_import {
    name: "LeanType",

    apk: "LeanType.apk",

    default_dev_cert: true,

    product_specific: true,

    overrides: [
        "LatinIME",
    ],

    dex_preopt: {
        enabled: true,
    },
}
